# ──────────────────────────────────────────────
# EnglishAI Backend Configuration
# Copy this file to `.env` and fill in real values.
# ──────────────────────────────────────────────

# Application
APP_NAME=EnglishAI
APP_VERSION=1.0.0
# "development" | "production"
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
# For local: postgresql+asyncpg://user:password@localhost:5432/english_ai
# For Supabase: use your Supabase connection string
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/english_ai
# SSL for the database connection. Leave empty to auto-detect
# (required for managed hosts like Supabase, off for local/Docker).
# DATABASE_SSL=false

# Google Sign-In — the OAuth 2.0 Web client ID (also used by the app).
# Leave empty to disable the /auth/google endpoint.
GOOGLE_OAUTH_CLIENT_ID=

# JWT
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# CORS - explicit web origins (development defaults + production)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]

# AI Service (Phase 3)
# The bundled local model is tried first. Cloud is used as a fallback
# when a key is configured and AI_CLOUD_FALLBACK=true.
AI_PROVIDER=local
AI_CLOUD_FALLBACK=true
LOCAL_LLM_ENABLED=true
LOCAL_LLM_PRELOAD=true
LOCAL_LLM_LOAD_TIMEOUT_SECONDS=120
LOCAL_LLM_TIMEOUT_SECONDS=60
# OPENAI_API_KEY=
# GOOGLE_AI_API_KEY=

# Speech Services (Phase 4)
# WHISPER_API_URL=
# TTS_API_KEY=

# Demo/offline fallback accounts (MUST be false in production)
ENABLE_DEMO_ACCOUNTS=true
DEMO_USER_PASSWORD=Password123
