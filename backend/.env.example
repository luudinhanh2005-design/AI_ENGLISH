# ──────────────────────────────────────────────
# EnglishAI Backend Configuration
# ──────────────────────────────────────────────

# Application
APP_NAME=EnglishAI
APP_VERSION=1.0.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
# For local: postgresql+asyncpg://user:password@localhost:5432/english_ai
# For Supabase: use your Supabase connection string
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/english_ai

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# AI Service (Phase 3)
# OPENAI_API_KEY=
# GOOGLE_AI_API_KEY=

# Speech Services (Phase 4)
# WHISPER_API_URL=
# TTS_API_KEY=
