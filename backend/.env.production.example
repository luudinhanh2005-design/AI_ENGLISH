# Production template. Copy to .env on the server and replace every placeholder.
# The application refuses to start with demo accounts or a weak/missing JWT
# secret while ENVIRONMENT=production.

ENVIRONMENT=production
DEBUG=false

HOST=0.0.0.0
PORT=8000

# Managed PostgreSQL connection string. Keep TLS enabled in production.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_SSL=true

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Explicit production web origins only. No wildcard/localhost entries.
CORS_ORIGINS=["https://YOUR_WEB_APP_ORIGIN"]

# Demo/offline accounts must stay disabled in production.
ENABLE_DEMO_ACCOUNTS=false

# Set the same Google OAuth web client ID used by the released app.
GOOGLE_OAUTH_CLIENT_ID=

# Optional AI provider configuration.
AI_PROVIDER=local
AI_CLOUD_FALLBACK=true
LOCAL_LLM_ENABLED=true
LOCAL_LLM_PRELOAD=true
